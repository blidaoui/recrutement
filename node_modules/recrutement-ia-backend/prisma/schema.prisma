generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDAT
  RECRUTEUR
  ADMIN
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String   @unique
  motDePasse String?
  googleId  String?  @unique
  role      Role     @default(CANDIDAT)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  cvs          CV[]
  offres       Offre[]        @relation("RecruteurOffres")
  candidatures Candidature[]
  convsCandidat  Conversation[] @relation("ConvCandidat")
  convsRecruteur Conversation[] @relation("ConvRecruteur")
  messagesSent   Message[]      @relation("MessageSender")
}

model CV {
  id              Int      @id @default(autoincrement())
  candidatId      Int
  candidat        User     @relation(fields: [candidatId], references: [id])
  urlFichier      String
  nomFichier      String?
  texteExtrait    String?
  skillsExtraites String[]
  createdAt       DateTime @default(now())
}

model Offre {
  id                 Int      @id @default(autoincrement())
  recruteurId        Int
  recruteur          User     @relation("RecruteurOffres", fields: [recruteurId], references: [id])
  titre              String
  entreprise         String?
  description        String
  skillsRequises     String[]
  skillsObligatoires String[]
  skillsSouhaitees   String[]
  experienceMin      Int      @default(0)
  niveauEtude        String   @default("Non précisé")
  langues            String[]
  salaire            Int?
  pays               String   @default("Non précisé")
  typeContrat        String   @default("Non précisé")
  statut             String   @default("ouverte")
  createdAt          DateTime @default(now())

  candidatures Candidature[]
}

model Candidature {
  id             Int               @id @default(autoincrement())
  candidatId     Int
  candidat       User              @relation(fields: [candidatId], references: [id])
  offreId        Int
  offre          Offre             @relation(fields: [offreId], references: [id])
  scoreMatching  Float             @default(0)
  statut         StatutCandidature @default(EN_ATTENTE)
  createdAt      DateTime          @default(now())

  @@unique([candidatId, offreId])
}

model Conversation {
  id           Int       @id @default(autoincrement())
  candidatId   Int
  recruteurId  Int
  candidat     User      @relation("ConvCandidat",   fields: [candidatId],  references: [id])
  recruteur    User      @relation("ConvRecruteur",  fields: [recruteurId], references: [id])
  createdAt    DateTime  @default(now())
  messages     Message[]

  @@unique([candidatId, recruteurId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  contenu        String
  lu             Boolean      @default(false)
  createdAt      DateTime     @default(now())
}
