generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDAT
  RECRUTEUR
  ADMIN
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model User {
  id         Int      @id @default(autoincrement())
  nom        String
  email      String   @unique
  motDePasse String?
  googleId   String?  @unique
  role       Role     @default(CANDIDAT)
  createdAt  DateTime @default(now())

  cvs          CV[]
  offres       Offre[]       @relation("RecruteurOffres")
  candidatures Candidature[]
}

model CV {
  id              Int      @id @default(autoincrement())
  candidatId      Int
  candidat        User     @relation(fields: [candidatId], references: [id])
  urlFichier      String
  texteExtrait    String?
  skillsExtraites String[]
  createdAt       DateTime @default(now())
}

model Offre {
  id             Int      @id @default(autoincrement())
  recruteurId    Int
  recruteur      User     @relation("RecruteurOffres", fields: [recruteurId], references: [id])
  titre          String
  description    String
  skillsRequises String[]
  createdAt      DateTime @default(now())

  candidatures Candidature[]
}

model Candidature {
  id            Int               @id @default(autoincrement())
  candidatId    Int
  candidat      User              @relation(fields: [candidatId], references: [id])
  offreId       Int
  offre         Offre             @relation(fields: [offreId], references: [id])
  scoreMatching Float             @default(0)
  statut        StatutCandidature @default(EN_ATTENTE)
  createdAt     DateTime          @default(now())

  @@unique([candidatId, offreId])
}
