/path>\n            </symbol>\n        </defs>\n    </svg>\n    <nav class=\"navbar\" data-kid=\"1-2\">\n        <div class=\"navbar-top\" data-kid=\"1-2-1\">\n            <a class=\"navbar-logo\" data-kid=\"1-2-1-1\">\n                <svg class=\"navbar-logo-mark\" data-kid=\"1-2-1-1-1\" fill=\"none\" height=\"26\" viewbox=\"0 0 26 26\" width=\"26\">\n                    <circle cx=\"10\" cy=\"13\" fill=\"#F2B84B\" r=\"8\">\n                    </circle>\n                    <circle cx=\"17\" cy=\"13\" fill=\"#FFFFFF\" fill-opacity=\".9\" r=\"8\">\n                    </circle>\n                </svg>\n                RecrutIA\n            </a>\n        </div>\n        <div class=\"navbar-links\" data-kid=\"1-2-2\">\n            <a data-kid=\"1-2-2-1\">\n                Offres d'emploi\n            </a>\n            <div class=\"user-nav\" data-kid=\"1-2-2-2\">\n                <a class=\"nav-messages-btn\" data-kid=\"1-2-2-2-1\" data-name=\"message button\">\n                    <svg class=\"icon\" data-kid=\"1-2-2-2-1-1\" data-name=\"chat message icon\">\n                        <use href=\"#chat\">\n                        </use>\n                    </svg>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"message notification count label\" data-reason=\"text set by script based on unread messages\">\n                        Messages\n                    </span>\n                </a>\n                <a class=\"nav-btn-dashboard\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"avatar avatar--sm\" data-kid=\"1-2-2-2-2-1\" id=\"candidate-avatar\" title=\"Amira Ben Salem\">\n                        <span data-kid=\"1-2-2-2-2-1-1\">\n                            AS\n                        </span>\n                    </div>\n                    Mon espace\n                </a>\n                <button class=\"nav-btn-logout\" data-kid=\"1-2-2-2-3\">\n                    Déconnexion\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-3\">\n        <div class=\"page-offres\" data-kid=\"1-3-1\">\n            <div class=\"offres-hero\" data-kid=\"1-3-1-1\">\n                <div class=\"offres-hero-text\" data-kid=\"1-3-1-1-1\">\n                    <h2 data-kid=\"1-3-1-1-1-1\">\n                        Offres d'emploi disponibles\n                    </h2>\n                    <p data-kid=\"1-3-1-1-1-2\">\n                        Trouvez votre prochain poste et postulez en 1 clic - notre IA analyse votre CV et calcule votre score de matching automatiquement.\n                    </p>\n                </div>\n                <div class=\"offres-hero-stats\" data-kid=\"1-3-1-1-2\">\n                    <span class=\"hero-stat\" data-kid=\"1-3-1-1-2-1\">\n                        <strong data-dynamic=\"true\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"total offers count number\" data-reason=\"value injected by jobs-listing script\">\n                            6\n                        </strong>\n                        offres\n                    </span>\n                    <span class=\"hero-stat hero-stat--open\" data-kid=\"1-3-1-1-2-2\">\n                        <strong data-dynamic=\"true\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"open offers count number\" data-reason=\"value injected by jobs-listing script\">\n                            5\n                        </strong>\n                        ouvertes\n                    </span>\n                </div>\n            </div>\n            <div class=\"offres-search-bar\" data-kid=\"1-3-1-2\">\n                <div class=\"offres-search-input-wrap\" data-kid=\"1-3-1-2-1\">\n                    <span class=\"search-icon\" data-kid=\"1-3-1-2-1-1\">\n                        <svg class=\"icon\" data-kid=\"1-3-1-2-1-1-1\">\n                            <use href=\"#search\">\n                            </use>\n                        </svg>\n                    </span>\n                    <input class=\"offres-search-input\" data-kid=\"1-3-1-2-1-2\" placeholder=\"Titre, entreprise, compétence...\" readonly=\"\"/>\n                </div>\n                <div class=\"searchable-select\" data-kid=\"1-3-1-2-2\">\n                    <div class=\"searchable-select-input-wrap\" data-kid=\"1-3-1-2-2-1\">\n                        <span class=\"search-icon\" data-kid=\"1-3-1-2-2-1-1\">\n                            <svg class=\"icon\" data-kid=\"1-3-1-2-2-1-1-1\">\n                                <use href=\"#location\">\n                                </use>\n                            </svg>\n                        </span>\n                        <input class=\"offres-search-input\" data-kid=\"1-3-1-2-2-1-2\" placeholder=\"Pays...\" readonly=\"\"/>\n                    </div>\n                </div>\n                <select aria-label=\"Type de contrat\" class=\"offres-filter-select\" data-kid=\"1-3-1-2-3\">\n                    <option data-kid=\"1-3-1-2-3-1\">\n                        Tous contrats\n                    </option>\n                </select>\n                <select aria-label=\"Statut\" class=\"offres-filter-select\" data-kid=\"1-3-1-2-4\">\n                    <option data-kid=\"1-3-1-2-4-1\">\n                        Toutes\n                    </option>\n                </select>\n            </div>\n            <p class=\"offres-result-count\" data-dynamic=\"true\" data-kid=\"1-3-1-3\" data-name=\"results count text\" data-reason=\"text updated based on job grid content\">\n                6 offres trouvées\n            </p>\n            <div class=\"offres-grid\" data-dynamic=\"true\" data-kid=\"1-3-1-4\" data-name=\"job offers grid container\" data-reason=\"children injected by jobs-listing script\" id=\"offers-grid\">\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    (function(){\nconst colors=['#4f46e5','#0ea5e9','#059669','#d97706','#dc2626','#7c3aed','#db2777'];let hash=0;const name='Amira Ben Salem';for(let i=0;i<name.length;i++)hash=name.charCodeAt(i)+((hash<<5)-hash);document.getElementById('candidate-avatar').style.backgroundColor=colors[Math.abs(hash)%colors.length];\nconst icon=id=>`<svg class=\"icon\" aria-hidden=\"true\"><use href=\"#${id}\"/></svg>`;\nconst jobs=[\n{title:'Développeur React',company:'Nova Digital',date:'Il y a 2h',exp:2,study:'Bac +3',salary:'2 500',country:'Tunisie',contract:'CDI',lang:'Français, Anglais',desc:'Rejoignez notre équipe pour concevoir des applications web modernes avec React. Vous participerez au développement de nouvelles fonctionnalités et à leur amélioration continue.',required:['React','JavaScript','HTML / CSS'],nice:['TypeScript'],count:12},\n{title:'Data Analyst',company:'Atlas Analytics',date:'Il y a 1 jour',exp:2,study:'Bac +5',salary:'3 000',country:'Tunisie',contract:'CDI',lang:'Français, Anglais',desc:'Nous recherchons un Data Analyst pour transformer nos données en indicateurs utiles. Vous travaillerez avec nos équipes métiers sur les tableaux de bord et les analyses.',required:['Python','SQL','Power BI'],nice:['Excel'],count:8},\n{title:'Designer UX/UI',company:'Studio Horizon',date:'Il y a 3 jours',exp:1,study:'Bac +3',salary:'2 200',country:'Tunisie',contract:'CDD',lang:'Français',desc:'Imaginez des interfaces intuitives et accompagnez nos clients dans la conception de leurs produits numériques, de la recherche utilisateur à la réalisation des maquettes.',required:['Figma','UX Design'],nice:['Adobe XD'],count:6},\n{title:'Ingénieur DevOps',company:'Cloudia Solutions',date:'Il y a 4 jours',exp:3,study:'Bac +5',salary:'3 800',country:'Tunisie',contract:'CDI',lang:'Anglais',desc:'Accompagnez nos équipes dans le déploiement et la supervision de leurs applications. Vous contribuerez à automatiser nos infrastructures et à renforcer leur fiabilité.',required:['Docker','Kubernetes','Linux'],nice:['AWS'],count:9},\n{title:'Stage marketing digital',company:'Lumière Conseil',date:'Il y a 5 jours',exp:0,study:'Bac +3',salary:'600',country:'Tunisie',contract:'Stage',lang:'Français',desc:'Participez à la création de contenus et au suivi de campagnes digitales. Une première expérience pour développer vos compétences au sein d’une équipe créative.',required:['Réseaux sociaux','Rédaction'],nice:['Canva'],count:15},\n{title:'Développeur backend',company:'Nexora Tech',date:'Il y a 1 semaine',exp:2,study:'Bac +5',salary:'2 800',country:'Tunisie',contract:'CDI',lang:'Français, Anglais',desc:'Développez des API robustes et évolutives pour nos services. Vous interviendrez sur la conception des bases de données et sur l’intégration des fonctionnalités métier.',required:['Node.js','PostgreSQL'],nice:['Prisma'],count:21,closed:true}\n];\ndocument.getElementById('offers-grid').innerHTML=jobs.map(j=>`<div class=\"ocard\"><div class=\"ocard-accent\"></div><div class=\"ocard-body\"><div class=\"ocard-head\"><div class=\"ocard-title-block\"><h3 class=\"ocard-title\">${j.title}</h3><span class=\"ocard-company\">${icon('office')} ${j.company}</span></div><span class=\"ocard-head-right\"><span class=\"ocard-statut ${j.closed?'ocard-statut--closed':'ocard-statut--open'}\">${j.closed?'Fermée':'Ouverte'}</span><span class=\"ocard-date\">${icon('clock')} ${j.date}</span></span></div><div class=\"ocard-meta\">${j.exp?`<span class=\"ocard-meta-pill\">${icon('timer')} ${j.exp} ans exp.</span>`:''}<span class=\"ocard-meta-pill\">${icon('student')} ${j.study}</span><span class=\"ocard-meta-pill ocard-meta-pill--salary\">${icon('salary')} ${j.salary} DT</span><span class=\"ocard-meta-pill\"> ${j.country}</span><span class=\"ocard-meta-pill ocard-meta-pill--contrat\">${j.contract}</span><span class=\"ocard-meta-pill\">${icon('language')} ${j.lang}</span></div><div class=\"ocard-desc-wrap\"><p class=\"ocard-desc\">${j.desc.length>130?j.desc.substring(0,130)+'…':j.desc}</p>${j.desc.length>130?'<button class=\"ocard-read-more\">Lire plus ▼</button>':''}</div><div class=\"ocard-skills\">${j.required.map(s=>`<span class=\"ocard-skill ocard-skill--required\">${s}</span>`).join('')}${j.nice.map(s=>`<span class=\"ocard-skill ocard-skill--nice\">${s}</span>`).join('')}</div></div><div class=\"ocard-footer\"><span class=\"ocard-candidats\">${icon('person')} ${j.count} candidatures</span><div class=\"ocard-footer-actions\"><button class=\"ocard-btn ocard-btn--contact\">${icon('chat')} Contacter</button><button class=\"ocard-btn ocard-btn--apply\" ${j.closed?'disabled':''}>${j.closed?'Offre fermée':'Postuler →'}</button></div></div></div>`).join('');\n})();\n</script>\n",
