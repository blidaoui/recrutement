      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@500;600&display=swap');\n@layer components {\n.reconstruction{font-family:'Segoe UI',system-ui,sans-serif;background:#f7f8fa;color:#2c3e50;line-height:normal;min-height:100vh}\n.reconstruction button,.reconstruction input{font-family:Arial,sans-serif;line-height:normal}\n.reconstruction button{cursor:pointer}.reconstruction button:disabled{opacity:.6;cursor:not-allowed}\n.reconstruction svg.icon{display:inline;width:1em;height:1em;color:inherit;fill:currentColor;vertical-align:baseline}\n.navbar{position:relative;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(120deg,#764090 0%,#4e2a68 100%);color:white;padding:1rem clamp(1rem,4vw,2rem);width:100%;font-family:Inter,sans-serif;border-bottom:1px solid rgba(242,184,75,.35)}\n.navbar-top{display:flex;align-items:center;flex-shrink:0;z-index:2}.navbar-logo{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.3rem;letter-spacing:-.01em;color:#fff;text-decoration:none;display:flex;align-items:center;gap:.5rem;white-space:nowrap}.navbar-logo-mark{flex-shrink:0;width:26px;height:26px;color:inherit}.navbar-links{display:flex;gap:clamp(.6rem,2vw,1.2rem);align-items:center;flex-wrap:nowrap;justify-content:flex-end}.navbar-links>a,.nav-messages-btn,.nav-btn-dashboard,.reconstruction .nav-btn-logout{position:relative;color:rgba(255,255,255,.78);text-decoration:none;font-family:Inter,sans-serif;font-size:.95rem;font-weight:500;background:none;border:none;padding:.3rem 0;white-space:nowrap}.user-nav{display:flex;align-items:center;flex-wrap:nowrap;gap:clamp(.5rem,1.5vw,1rem)}.nav-messages-btn{display:flex;align-items:center;gap:.4rem}.nav-messages-btn svg{font-size:1.1rem}.nav-btn-dashboard{display:inline-flex;align-items:center;gap:8px}.avatar{border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;color:#fff;font-weight:600;user-select:none}.avatar--sm{width:28px;height:28px;font-size:.7rem}\n.reconstruction main{padding:2rem;max-width:1200px;margin:0 auto}.page-offres{padding-bottom:2rem}.offres-hero{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;background:linear-gradient(135deg,#4361ee 0%,#764090 100%);border-radius:16px;padding:2rem 2.5rem;margin-bottom:2rem;color:#fff}.offres-hero-text h2{margin:0 0 .4rem;font-size:1.7rem;font-weight:800}.offres-hero-text p{margin:0;font-size:.95rem;opacity:.88;max-width:560px;line-height:1.5}.offres-hero-stats{display:flex;gap:1rem;flex-shrink:0}.hero-stat{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:.6rem 1.2rem;font-size:.88rem;text-align:center;backdrop-filter:blur(4px)}.hero-stat strong{display:block;font-size:1.6rem;font-weight:800;line-height:1;margin-bottom:.15rem}.hero-stat--open{background:rgba(34,197,94,.25);border-color:rgba(34,197,94,.4)}\n.offres-search-bar{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin-bottom:1.5rem}.offres-search-input-wrap{flex:1;min-width:240px;position:relative;display:flex;align-items:center}.search-icon{position:absolute;left:.9rem;font-size:1rem;pointer-events:none;opacity:.5}.offres-search-input{width:100%;padding:.7rem 2.5rem .7rem 2.4rem;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.93rem;background:#fff;outline:none;box-shadow:0 1px 4px rgba(0,0,0,.04);color:#000}.offres-search-input::placeholder{color:#757575;opacity:1}.searchable-select{position:relative;flex:1;min-width:160px}.searchable-select-input-wrap{position:relative;display:flex;align-items:center}.offres-filter-select{padding:.68rem .9rem;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.88rem;font-family:inherit;background:#fff;color:#334155;font-weight:500;outline:none;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.04);min-width:150px;appearance:auto;line-height:normal}.offres-result-count{font-size:.85rem;color:#94a3b8;font-weight:500;margin:0 0 1rem}.offres-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:1.5rem;align-items:start}\n.ocard{background:#fff;border-radius:14px;border:1.5px solid #e2e8f0;box-shadow:0 2px 12px rgba(0,0,0,.05);display:flex;flex-direction:column;overflow:hidden}.ocard-accent{height:4px;background:linear-gradient(90deg,#4361ee,#764090);flex-shrink:0}.ocard-body{padding:1.25rem 1.4rem;flex:1;display:flex;flex-direction:column;gap:.75rem}.ocard-head{display:flex;justify-content:space-between;align-items:flex-start;gap:.75rem}.ocard-title-block{flex:1;min-width:0}.ocard-title{margin:0 0 .25rem;font-size:1.05rem;font-weight:700;color:#1e293b;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ocard-company{font-size:.82rem;color:#64748b;font-weight:500}.ocard-head-right{display:flex;flex-direction:column;align-items:flex-end;gap:5px;flex:none}.ocard-statut{flex-shrink:0;font-size:.72rem;font-weight:700;padding:.25rem .65rem;border-radius:20px;white-space:nowrap}.ocard-statut--open{background:#dcfce7;color:#15803d}.ocard-statut--closed{background:#f1f5f9;color:#94a3b8}.ocard-date{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;color:#8a97a3;white-space:nowrap}.ocard-date svg{font-size:12px}.ocard-meta{display:flex;flex-wrap:wrap;gap:.35rem}.ocard-meta-pill{font-size:.75rem;background:#f8fafc;color:#475569;border:1px solid #e2e8f0;padding:.2rem .6rem;border-radius:20px;font-weight:500}.ocard-meta-pill--salary{background:#fefce8;color:#854d0e;border-color:#fde68a}.ocard-meta-pill--contrat{background:#f0fdf4;color:#15803d;border-color:#bbf7d0;font-weight:700}.ocard-desc-wrap{flex:1}.ocard-desc{margin:0 0 .3rem;font-size:.88rem;color:#475569;line-height:1.55;white-space:pre-line}.ocard-read-more{background:none;border:none;padding:0;font-size:.8rem;font-weight:600;color:#4361ee;cursor:pointer;text-decoration:none}.ocard-skills{display:flex;flex-wrap:wrap;gap:.35rem}.ocard-skill{font-size:.75rem;font-weight:600;padding:.2rem .6rem;border-radius:20px;background:#f1f5f9;color:#475569;border:1px solid #e2e8f0}.ocard-skill--required{background:#fef3c7;color:#92400e;border-color:#fde68a}.ocard-skill--nice{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}.ocard-footer{display:flex;justify-content:space-between;align-items:center;padding:.85rem 1.4rem;border-top:1px solid #f1f5f9;background:#fafafa;flex-wrap:wrap;gap:.5rem}.ocard-candidats{font-size:.8rem;color:#94a3b8;font-weight:500}.ocard-footer-actions{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}.ocard-btn{padding:.55rem 1.25rem;border-radius:8px;font-size:.88rem;font-weight:700;border:none;cursor:pointer;white-space:nowrap}.ocard-btn--apply{background:linear-gradient(135deg,#4361ee,#764090);color:#fff;box-shadow:0 3px 10px rgba(67,97,238,.3)}.ocard-btn--apply:disabled{background:#e2e8f0;color:#94a3b8;box-shadow:none;cursor:not-allowed}.ocard-btn--contact{background:#f0fdf4;color:#15803d;border:1.5px solid #bbf7d0;padding:.5rem 1rem;border-radius:8px;font-size:.85rem;font-weight:600;cursor:pointer;white-space:nowrap}\n}\n</style>\n<div class=\"reconstruction\" data-kid=\"1\">\n    <svg aria-hidden=\"true\" data-kid=\"1-1\" style=\"display:none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n            <symbol id=\"office\" viewbox=\"0 0 16 16\">\n                <path d=\"M0 16h8v-16h-8v16zM5 2h2v2h-2v-2zM5 6h2v2h-2v-2zM5 10h2v2h-2v-2zM1 2h2v2h-2v-2zM1 6h2v2h-2v-2zM1 10h2v2h-2v-2zM9 5h7v1h-7zM9 16h2v-4h3v4h2v-9h-7z\">\n                </path>\n            </symbol>\n            <symbol id=\"clock\" viewbox=\"0 0 24 24\">\n                <path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2M12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8m.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\">\n                </path>\n            </symbol>\n            <symbol id=\"timer\" viewbox=\"0 0 24 24\">\n                <path d=\"M