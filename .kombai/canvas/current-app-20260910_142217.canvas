      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@500;600&display=swap');\n@layer components {\n.current-candidate {font-family:'Segoe UI',system-ui,sans-serif;background:#f7f8fa;color:#2c3e50;font-size:16px;line-height:normal;min-height:100vh;}\n.current-candidate button {font-family:Arial,sans-serif;line-height:normal;cursor:pointer;}\n.current-candidate .navbar {display:flex;justify-content:space-between;align-items:center;background:linear-gradient(120deg,#764090 0%,#4e2a68 100%);color:white;padding:1rem 2rem;width:100%;font-family:'Inter',sans-serif;border-bottom:1px solid rgba(242,184,75,.35);}\n.current-candidate .navbar-logo {font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.3rem;letter-spacing:-.01em;color:#fff;text-decoration:none;display:flex;align-items:center;gap:.5rem;white-space:nowrap;}\n.current-candidate .navbar-links {display:flex;gap:1.2rem;align-items:center;justify-content:flex-end;}\n.current-candidate .user-nav {display:flex;align-items:center;gap:1rem;}\n.current-candidate .navbar-links a,.current-candidate .nav-btn-logout {color:rgba(255,255,255,.78);text-decoration:none;font-family:'Inter',sans-serif;font-size:.95rem;font-weight:500;background:none;border:none;padding:.3rem 0;white-space:nowrap;}\n.current-candidate .nav-messages-btn {display:flex;align-items:center;gap:.4rem;line-height:1;}\n.current-candidate .nav-btn-dashboard {display:inline-flex;align-items:center;gap:8px;}\n.current-candidate .avatar {border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;color:#fff;font-weight:600;width:28px;height:28px;font-size:.7rem;background:#7c3aed;}\n.current-candidate main {padding:2rem;max-width:1200px;margin:0 auto;}\n.current-candidate .page-espace-candidat {max-width:1200px;margin:0 auto;padding:0 1rem;}\n.current-candidate .espace-tabs {display:flex;gap:.5rem;border-bottom:1px solid #e5e0ec;margin-bottom:2rem;}\n.current-candidate .espace-tab {background:none;border:none;padding:.9rem 1.4rem;font-size:.95rem;font-weight:600;color:#6b6473;position:relative;}\n.current-candidate .espace-tab.active {color:#764090;}\n.current-candidate .espace-tab.active:after {content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;background:#f2b84b;}\n.current-candidate .dashboard-header {margin-bottom:1.75rem;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0;}\n.current-candidate .dashboard-header h2 {margin:0 0 .3rem;color:#1e293b;font-size:1.7rem;font-weight:700;}\n.current-candidate .dashboard-header p {margin:0;color:#64748b;font-size:.95rem;}\n.current-candidate section {margin-bottom:2.5rem;}\n.current-candidate section>h3 {font-size:1.17em;font-weight:bold;margin:1em 0;}\n.current-candidate .cv-management-card {background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:1.6rem;box-shadow:0 4px 15px rgba(0,0,0,.04);}\n.current-candidate .active-cv-box {display:flex;flex-direction:column;gap:1.2rem;}\n.current-candidate .active-cv-header {display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f1f5f9;padding-bottom:1rem;}\n.current-candidate .active-badge {display:inline-block;background:#dcfce7;color:#15803d;font-weight:700;font-size:.8rem;padding:.25rem .65rem;border-radius:12px;margin-bottom:.4rem;}\n.current-candidate .cv-date {margin:0;color:#1e293b;font-size:1.05rem;font-weight:600;}\n.current-candidate .btn-update-cv {background:#f1f5f9;color:#334155;border:1.5px solid #cbd5e1;padding:.55rem .95rem;border-radius:8px;font-size:.88rem;font-weight:600;}\n.current-candidate .cv-contact-details {background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:1.1rem;}\n.current-candidate .details-section-title {margin:0 0 .6rem;font-size:.95rem;color:#1e293b;font-weight:700;}\n.current-candidate .contact-grid {display:grid;grid-template-columns:1fr 1fr;gap:.8rem;}\n.current-candidate .contact-item {display:flex;flex-direction:column;gap:.2rem;}\n.current-candidate .contact-item.full {grid-column:span 2;margin-top:.4rem;}\n.current-candidate .contact-label {font-size:.8rem;color:#64748b;font-weight:600;}\n.current-candidate .contact-value {font-size:.92rem;color:#1e293b;font-weight:600;}\n.current-candidate .btn-download-cv {display:inline-flex;align-items:center;gap:.5rem;background:#4361ee;color:white;padding:.55rem 1rem;border-radius:8px;font-size:.88rem;font-weight:600;text-decoration:none;border:2px outset buttonborder;}\n.current-candidate .cv-extracted-skills {display:flex;flex-direction:column;gap:.6rem;}\n.current-candidate .skills-badge-list {display:flex;flex-wrap:wrap;gap:.5rem;}\n.current-candidate .skill-badge-lg {background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;padding:.35rem .85rem;border-radius:14px;font-size:.85rem;font-weight:600;}\n.current-candidate .cv-text-preview-box {background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:1.1rem;}\n.current-candidate .preview-header {display:flex;justify-content:space-between;align-items:center;}\n.current-candidate .btn-toggle-text {background:none;border:none;color:#4361ee;font-size:.82rem;font-weight:600;padding:0;}\n.current-candidate .cv-text-content p {margin:0;font-size:.88rem;color:#475569;line-height:1.6;white-space:pre-line;}\n.current-candidate .table-responsive {overflow-x:auto;}\n.current-candidate .candidatures-table {width:100%;border-collapse:collapse;background:white;font-size:.88rem;}\n.current-candidate .candidatures-table th {padding:.75rem .8rem;text-align:left;border-bottom:2px solid #e2e8f0;color:#64748b;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:#f8fafc;}\n.current-candidate .candidatures-table td {padding:.75rem .8rem;text-align:left;border-bottom:1px solid #f1f5f9;vertical-align:middle;}\n.current-candidate .candidat-info {display:flex;flex-direction:column;}\n.current-candidate .candidat-nom {font-weight:600;color:#1e293b;font-size:.92rem;}\n.current-candidate .candidat-email {font-size:.8rem;color:#64748b;}\n.current-candidate .mini-skill-badge {background:#f1f5f9;color:#475569;padding:.15rem .5rem;border-radius:10px;font-size:.72rem;font-weight:600;}\n.current-candidate .score-badge {padding:.2rem .6rem;border-radius:12px;font-weight:bold;color:white;}\n.current-candidate .score-haut {background:#2ecc71;}\n.current-candidate .score-moyen {background:#f39c12;}\n.current-candidate .statut-pill {display:inline-block;padding:.25rem .75rem;border-radius:12px;font-size:.8rem;font-weight:600;}\n.current-candidate .statut-attente {background:#fef3c7;color:#92400e;}\n.current-candidate .statut-acceptee {background:#dcfce7;color:#166534;}\n.current-candidate .statut-refusee {background:#fee2e2;color:#991b1b;}\n.current-candidate .btn-view-cv-details {background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;padding:.35rem .75rem;border-radius:6px;font-size:.82rem;}\n}\n</style>\n<div class=\"current-candidate\" data-kid=\"1\">\n    <nav class=\"navbar\" data-kid=\"1-1\">\n        <div data-kid=\"1-1-1\">\n            <a class=\"navbar-logo\" data-kid=\"1-1-1-1\">\n                <svg data-kid=\"1-1-1-1-1\" fill=\"none\" height=\"26\" style=\"color:#fff;width:26px;height:26px\" viewbox=\"0 0 26 26\" width=\"26\">\n                    <circle cx=\"10\" cy=\"13\" fill=\"#F2B84B\" r=\"8\">\n                    </circle>\n                    <circle cx=\"17\" cy=\"13\" fill=\"#FFFFFF\" fill-opacity=\"0.9\" r=\"8\">\n                    </circle>\n                </svg>\n                RecrutIA\n            </a>\n        </div>\n        <div class=\"navbar-links\" data-kid=\"1-1-2\">\n            <a data-kid=\"1-1-2-1\">\n                Offres d'emploi\n            </a>\n            <div class=\"user-nav\" data-kid=\"1-1-2-2\">\n                <a class=\"nav-messages-btn\" data-kid=\"1-1-2-2-1\">\n                    <svg data-kid=\"1-1-2-2-1-1\" fill=\"currentColor\" fill-rule=\"evenodd\" style=\"color:inherit;width:17.6px;height:17.6px\" viewbox=\"0 0 1024 1024\">\n                        <path d=\"M845.784 581.585a135.867 135.867 0 0 0-47.042 19.049 114.236 114.236 0 0 1-51.41 31.075c2.613-17.554 11.313-33.577 24.455-45.418a169.303 169.303 0 0 0 23.409-55.017c-.061-27.838 22.44-50.459 50.265-50.534 27.827-.076 50.45 22.423 50.539 50.26.089 27.839-22.39 50.482-50.215 50.585zM753.568 460.83a168.829 168.829 0 0 0-54.808-23.68c-27.836 0-50.402-22.575-50.402-50.423 0-27.848 22.566-50.423 50.402-50.423 27.836 0 50.402 22.575 50.402 50.423a137.497 137.497 0 0 0 18.817 47.211 114.809 114.809 0 0 1 30.764 51.656 76.08 76.08 0 0 1-45.026-24.763h-.186zm-83.033-177.713C655.34 155.789 523.548 56.026 364.09 56.026c-169.874 0-308.088 113.097-308.088 252.19 2.72 78.1 43.941 149.778 110.063 191.385a311.284 311.284 0 0 0 33.602 21.588l-13.664 54.569c4.928 2.316 9.706 4.78 14.746 6.91l68.996-34.512c10.08 2.615 20.683 4.295 31.21 6.088 6.721 1.195 13.442 2.428 20.35 3.25a354.835 354.835 0 0 0 128.805-7.396 248.885 248.885 0 0 0 10.154 55.055 425.638 425.638 0 0 1-96.175 11.242 417.983 417.983 0 0 1-86.392-9.524l-125.186 62.526a27.619 27.619 0 0 1-29.98-3.137 28.019 28.019 0 0 1-9.67-28.611l22.401-90.239C53.176 495.186 2.463 405.506 0 308.216 0 137.973 163.004 0 364.09 0c190.93 0 347.29 124.527 362.521 282.818a244.967 244.967 0 0 0-26.47-2.614c-9.893.374-19.787 1.307-29.607 2.876zM554.237 481.934c16.764-3.362 32.706-9.786 47.042-19.049a114.236 114.236 0 0 1 51.447-31.001 76.466 76.466 0 0 1-24.491 45.344c-11.014 16.807-18.929 35.483-23.409 55.054.041 27.833-22.468 50.435-50.29 50.497-27.821.062-50.43-22.44-50.514-50.273-.082-27.833 22.393-50.469 50.215-50.572m90.798 121.314c16.652 11.168 35.17 19.236 54.659 23.904 20.386 0 38.764 12.286 46.565 31.127 7.801 18.842 3.49 40.53-10.926 54.95-14.414 14.422-36.093 18.736-54.927 10.931-18.834-7.804-31.114-26.19-31.114-46.585a136.736 136.736 0 0 0-18.668-47.285 114.714 114.714 0 0 1-30.54-51.805 76 76 0 0 1 44.951 25.062z\" transform=\"translate(64 148)\">\n                        </path>\n                    </svg>\n                    <span data-kid=\"1-1-2-2-1-2\">\n                        Messages\n                    </span>\n                </a>\n                <a class=\"nav-btn-dashboard\" data-kid=\"1-1-2-2-2\">\n                    <div class=\"avatar\" data-kid=\"1-1-2-2-2-1\" title=\"Amine Benali\">\n                        AB\n                    </div>\n                    Mon espace\n                </a>\n                <button class=\"nav-btn-logout\" data-kid=\"1-1-2-2-3\">\n                    Déconnexion\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\">\n        <div class=\"page-espace-candidat\" data-kid=\"1-2-1\">\n            <div class=\"espace-tabs\" data-kid=\"1-2-1-1\">\n                <button class=\"espace-tab active\" data-kid=\"1-2-1-1-1\">\n                    Tableau de bord\n                </button>\n                <button class=\"espace-tab\" data-kid=\"1-2-1-1-2\">\n                    Mon profil\n                </button>\n            </div>\n            <div class=\"page-dashboard\" data-kid=\"1-2-1-2\">\n                <div class=\"dashboard-header\" data-kid=\"1-2-1-2-1\">\n                    <h2 data-kid=\"1-2-1-2-1-1\">\n                        Mon Espace Candidat\n                    </h2>\n                    <p data-kid=\"1-2-1-2-1-2\">\n                        Gérez votre CV, visualisez vos compétences détectées et suivez vos candidatures.\n                    </p>\n                </div>\n                <section class=\"dashboard-section\" data-kid=\"1-2-1-2-2\">\n                    <h3 data-kid=\"1-2-1-2-2-1\">\n                        Mon CV & Compétences IA\n                    </h3>\n                    <div class=\"cv-management-card\" data-kid=\"1-2-1-2-2-2\">\n                        <div class=\"active-cv-box\" data-kid=\"1-2-1-2-2-2-1\">\n                            <div class=\"active-cv-header\" data-kid=\"1-2-1-2-2-2-1-1\">\n                                <div data-kid=\"1-2-1-2-2-2-1-1-1\">\n                                    <span class=\"active-badge\" data-kid=\"1-2-1-2-2-2-1-1-1-1\">\n                                        CV Actif\n                                    </span>\n                                    <h4 class=\"cv-date\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-1-1-2\" data-name=\"last update date of the cv\" data-reason=\"date updated dynamically by system based on last file upload\">\n                                        Mis à jour le 8 septembre 2026 à 10:30\n                                    </h4>\n                                </div>\n                                <button class=\"btn-update-cv\" data-kid=\"1-2-1-2-2-2-1-1-2\">\n                                    Mettre à jour mon CV\n                                </button>\n                            </div>\n                            <div class=\"cv-contact-details\" data-kid=\"1-2-1-2-2-2-1-2\">\n                                <h5 class=\"details-section-title\" data-kid=\"1-2-1-2-2-2-1-2-1\">\n                                    Coordonnées extraites du CV\n                                </h5>\n                                <div class=\"contact-grid\" data-kid=\"1-2-1-2-2-2-1-2-2\">\n                                    <div class=\"contact-item\" data-kid=\"1-2-1-2-2-2-1-2-2-1\">\n                                        <span class=\"contact-label\" data-kid=\"1-2-1-2-2-2-1-2-2-1-1\">\n                                            Email détecté :\n                                        </span>\n                                        <span class=\"contact-value\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-2-2-1-2\" data-name=\"detected email address from cv\" data-reason=\"email content fetched and displayed from user cv file\">\n                                            amine.benali@example.com\n                                        </span>\n                                    </div>\n                                    <div class=\"contact-item\" data-kid=\"1-2-1-2-2-2-1-2-2-2\">\n                                        <span class=\"contact-label\" data-kid=\"1-2-1-2-2-2-1-2-2-2-1\">\n                                            Téléphone :\n                                        </span>\n                                        <span class=\"contact-value\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-2-2-2-2\" data-name=\"detected phone number from cv\" data-reason=\"phone number content fetched and displayed from user cv file\">\n                                            +33 6 12 34 56 78\n                                        </span>\n                                    </div>\n                                    <div class=\"contact-item full\" data-kid=\"1-2-1-2-2-2-1-2-2-3\">\n                                        <button class=\"btn-download-cv\" data-kid=\"1-2-1-2-2-2-1-2-2-3-1\">\n                                            Télécharger le fichier original\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"cv-extracted-skills\" data-kid=\"1-2-1-2-2-2-1-3\">\n                                <h5 class=\"details-section-title\" data-kid=\"1-2-1-2-2-2-1-3-1\">\n                                    Compétences clés détectées (6)\n                                </h5>\n                                <div class=\"skills-badge-list\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-3-2\" data-name=\"list of skills extracted from cv\" data-reason=\"skills list dynamically rendered from analysis of cv file\">\n                                    <span class=\"skill-badge-lg\" data-kid=\"1-2-1-2-2-2-1-3-2-1\">\n                                        React\n                                    </span>\n                                    <span class=\"skill-badge-lg\" data-kid=\"1-2-1-2-2-2-1-3-2-2\">\n                                        JavaScript\n                                    </span>\n                                    <span class=\"skill-badge-lg\" data-kid=\"1-2-1-2-2-2-1-3-2-3\">\n                                        Node.js\n                                    </span>\n                                    <span class=\"skill-badge-lg\" data-kid=\"1-2-1-2-2-2-1-3-2-4\">\n                                        SQL\n                                    </span>\n                                    <span class=\"skill-badge-lg\" data-kid=\"1-2-1-2-2-2-1-3-2-5\">\n                                        Git\n                                    </span>\n                                    <span class=\"skill-badge-lg\" data-kid=\"1-2-1-2-2-2-1-3-2-6\">\n                                        HTML / CSS\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"cv-text-preview-box\" data-kid=\"1-2-1-2-2-2-1-4\">\n                                <div class=\"preview-header\" data-kid=\"1-2-1-2-2-2-1-4-1\">\n                                    <h5 class=\"details-section-title\" data-kid=\"1-2-1-2-2-2-1-4-1-1\">\n                                        Aperçu du contenu extrait du CV\n                                    </h5>\n                                    <button class=\"btn-toggle-text\" data-kid=\"1-2-1-2-2-2-1-4-1-2\">\n                                        Voir le texte extrait complet\n                                    </button>\n                                </div>\n                                <div class=\"cv-text-content\" data-kid=\"1-2-1-2-2-2-1-4-2\">\n                                    <p data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-4-2-1\" data-name=\"text preview of cv\" data-reason=\"text content extracted and rendered from user cv file\">\n                                        Amine Benali — Développeur web full stack\nDéveloppeur avec 3 ans d'expérience dans la conception d'applications web avec React et Node.js. Maîtrise de JavaScript, SQL, Git et HTML / CSS. Diplômé d'un master en informatique, je recherche une nouvelle opportunité...\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section class=\"dashboard-section\" data-kid=\"1-2-1-2-3\">\n                    <h3 data-kid=\"1-2-1-2-3-1\">\n                        Mes Candidatures en cours (3)\n                    </h3>\n                    <div class=\"table-responsive\" data-kid=\"1-2-1-2-3-2\">\n                        <table class=\"candidatures-table\" data-kid=\"1-2-1-2-3-2-1\">\n                            <thead data-kid=\"1-2-1-2-3-2-1-1\">\n                                <tr data-kid=\"1-2-1-2-3-2-1-1-1\">\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-1\">\n                                        Offre\n                                    </th>\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-2\">\n                                        Entreprise\n                                    </th>\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-3\">\n                                        Contrat\n                                    </th>\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-4\">\n                                        Matching IA\n                                    </th>\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-5\">\n                                        Statut\n                                    </th>\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-6\">\n                                        Envoyée le\n                                    </th>\n                                    <th data-kid=\"1-2-1-2-3-2-1-1-1-7\">\n                                        Détails\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2\" data-name=\"applications list\" data-reason=\"rows rendered dynamically based on user application history\">\n                                <tr data-kid=\"1-2-1-2-3-2-1-2-1\">\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-1\">\n                                        <div class=\"candidat-info\" data-kid=\"1-2-1-2-3-2-1-2-1-1-1\">\n                                            <span class=\"candidat-nom\" data-kid=\"1-2-1-2-3-2-1-2-1-1-1-1\">\n                                                Développeur React\n                                            </span>\n                                            <span class=\"candidat-email\" data-kid=\"1-2-1-2-3-2-1-2-1-1-1-2\">\n                                                France\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-2\">\n                                        NovaTech\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-3\">\n                                        <span class=\"mini-skill-badge\" data-kid=\"1-2-1-2-3-2-1-2-1-3-1\">\n                                            CDI\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-4\">\n                                        <div data-kid=\"1-2-1-2-3-2-1-2-1-4-1\">\n                                            <span class=\"score-badge score-haut\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2-1-4-1-1\" data-name=\"matching ai score\" data-reason=\"score calculated and rendered dynamically by ai matching algorithm\">\n                                                92%\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-5\">\n                                        <span class=\"statut-pill statut-attente\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2-1-5-1\" data-name=\"application status badge\" data-reason=\"status label updated dynamically based on application workflow\">\n                                            En attente\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-6\">\n                                        09 sept. 2026\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-1-7\">\n                                        <button class=\"btn-view-cv-details\" data-kid=\"1-2-1-2-3-2-1-2-1-7-1\">\n                                            Voir l'offre\n                                        </button>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-1-2-3-2-1-2-2\">\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-1\">\n                                        <div class=\"candidat-info\" data-kid=\"1-2-1-2-3-2-1-2-2-1-1\">\n                                            <span class=\"candidat-nom\" data-kid=\"1-2-1-2-3-2-1-2-2-1-1-1\">\n                                                Développeur Full Stack\n                                            </span>\n                                            <span class=\"candidat-email\" data-kid=\"1-2-1-2-3-2-1-2-2-1-1-2\">\n                                                France\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-2\">\n                                        Atlas Digital\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-3\">\n                                        <span class=\"mini-skill-badge\" data-kid=\"1-2-1-2-3-2-1-2-2-3-1\">\n                                            CDI\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-4\">\n                                        <div data-kid=\"1-2-1-2-3-2-1-2-2-4-1\">\n                                            <span class=\"score-badge score-haut\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2-2-4-1-1\" data-name=\"matching ai score\" data-reason=\"score calculated and rendered dynamically by ai matching algorithm\">\n                                                85%\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-5\">\n                                        <span class=\"statut-pill statut-acceptee\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2-2-5-1\" data-name=\"application status badge\" data-reason=\"status label updated dynamically based on application workflow\">\n                                            Acceptée\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-6\">\n                                        07 sept. 2026\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-2-7\">\n                                        <button class=\"btn-view-cv-details\" data-kid=\"1-2-1-2-3-2-1-2-2-7-1\">\n                                            Voir l'offre\n                                        </button>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-1-2-3-2-1-2-3\">\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-1\">\n                                        <div class=\"candidat-info\" data-kid=\"1-2-1-2-3-2-1-2-3-1-1\">\n                                            <span class=\"candidat-nom\" data-kid=\"1-2-1-2-3-2-1-2-3-1-1-1\">\n                                                Ingénieur logiciel\n                                            </span>\n                                            <span class=\"candidat-email\" data-kid=\"1-2-1-2-3-2-1-2-3-1-1-2\">\n                                                Maroc\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-2\">\n                                        Horizon Solutions\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-3\">\n                                        <span class=\"mini-skill-badge\" data-kid=\"1-2-1-2-3-2-1-2-3-3-1\">\n                                            CDD\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-4\">\n                                        <div data-kid=\"1-2-1-2-3-2-1-2-3-4-1\">\n                                            <span class=\"score-badge score-moyen\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2-3-4-1-1\" data-name=\"matching ai score\" data-reason=\"score calculated and rendered dynamically by ai matching algorithm\">\n                                                58%\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-5\">\n                                        <span class=\"statut-pill statut-refusee\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2-3-5-1\" data-name=\"application status badge\" data-reason=\"status label updated dynamically based on application workflow\">\n                                            Refusée\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-6\">\n                                        04 sept. 2026\n                                    </td>\n                                    <td data-kid=\"1-2-1-2-3-2-1-2-3-7\">\n                                        <button class=\"btn-view-cv-details\" data-kid=\"1-2-1-2-3-2-1-2-3-7-1\">\n                                            Voir l'offre\n                                        </button>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </main>\n</div>\n",
