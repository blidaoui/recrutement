                   <td data-kid=\"1-2-5-3-2-5-6\">\n                            08 sept. 2026\n                        </td>\n                        <td data-kid=\"1-2-5-3-2-5-7\">\n                            <span class=\"statut-pill statut-acceptee\" data-kid=\"1-2-5-3-2-5-7-1\" data-name=\"account status pill\">\n                                Actif\n                            </span>\n                        </td>\n                        <td data-kid=\"1-2-5-3-2-5-8\">\n                            <div class=\"action-buttons-group\" data-kid=\"1-2-5-3-2-5-8-1\">\n                                <button class=\"btn-action btn-reject\" data-kid=\"1-2-5-3-2-5-8-1-1\" data-name=\"deactivate user account button\">\n                                    Désactiver\n                                </button>\n                                <button class=\"btn-action btn-reject\" data-kid=\"1-2-5-3-2-5-8-1-2\" data-name=\"delete user account button\">\n                                    Supprimer\n                                </button>\n                            </div>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </main>\n</div>\n<script type=\"module\">\n    import Chart from 'https://cdn.jsdelivr.net/npm/chart.js@4.4.7/auto/+esm';\n    (function(){\nconst name='Sophie Laurent';let hash=0;for(let i=0;i<name.length;i++)hash=name.charCodeAt(i)+((hash<<5)-hash);document.getElementById('admin-avatar').style.backgroundColor=['#4f46e5','#0ea5e9','#059669','#d97706','#dc2626','#7c3aed','#db2777'][Math.abs(hash)%7];\nChart.defaults.font.family=\"'Segoe UI',system-ui,sans-serif\";Chart.defaults.color='#666';\ndocument.querySelectorAll('.chart-fallback').forEach(el=>el.style.display='none');\nnew Chart(document.getElementById('admin-status-chart'),{type:'doughnut',data:{labels:['En attente','Acceptée','Refusée'],datasets:[{data:[12,7,4],backgroundColor:['#f59e0b','#22c55e','#ef4444'],borderColor:'#fff',borderWidth:1}]},options:{responsive:true,maintainAspectRatio:false,cutout:'47%',rotation:90,circumference:360,animation:false,plugins:{legend:{display:false}}},plugins:[{id:'values',afterDatasetsDraw(chart){const ctx=chart.ctx;ctx.save();ctx.font='700 13px Segoe UI';ctx.fillStyle='#fff';ctx.textAlign='center';ctx.textBaseline='middle';chart.getDatasetMeta(0).data.forEach((a,i)=>{const p=a.tooltipPosition();ctx.fillText(chart.data.datasets[0].data[i],p.x,p.y)});ctx.restore();}}]});\nnew Chart(document.getElementById('admin-offers-chart'),{type:'bar',data:{labels:['Développeur React','Data Analyst','Designer UX/UI','Ingénieur DevOps','Chef de projet'],datasets:[{label:'Candidatures',data:[8,6,4,3,2],backgroundColor:'#6366f1',borderRadius:{topLeft:0,bottomLeft:0,topRight:4,bottomRight:4},barPercentage:.9,categoryPercentage:.8}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,animation:false,layout:{padding:{top:5,right:20,left:10,bottom:5}},plugins:{legend:{display:false}},scales:{x:{min:0,max:8,ticks:{stepSize:2,font:{size:11}},grid:{drawOnChartArea:false},border:{color:'#666'}},y:{ticks:{font:{size:10}},afterFit(axis){axis.width=130},grid:{drawOnChartArea:false},border:{color:'#666'}}}});\n})();\n</script>\n",
