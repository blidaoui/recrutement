      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@500;600&display=swap');\n.reconstruction{font-family:'Segoe UI',system-ui,sans-serif;background:#f7f8fa;color:#2c3e50;line-height:normal;min-height:100vh;font-size:16px}\n.reconstruction button{font-family:Arial,sans-serif;line-height:normal;cursor:pointer}\n.reconstruction svg{display:inline-block;vertical-align:middle;color:inherit;fill:currentColor}\n.navbar{position:relative;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(120deg,#764090 0%,#4e2a68 100%);color:white;padding:1rem clamp(1rem,4vw,2rem);width:100%;font-family:'Inter',sans-serif;border-bottom:1px solid rgba(242,184,75,.35)}\n.navbar-top{display:flex;align-items:center;flex-shrink:0;z-index:2}.navbar-logo{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.3rem;letter-spacing:-.01em;color:#fff;text-decoration:none;display:flex;align-items:center;gap:.5rem;white-space:nowrap}.navbar-logo-mark{flex-shrink:0}.navbar-links{display:flex;gap:clamp(.6rem,2vw,1.2rem);align-items:center;flex-wrap:nowrap;justify-content:flex-end}.user-nav{display:flex;align-items:center;flex-wrap:nowrap;gap:clamp(.5rem,1.5vw,1rem)}.navbar-links>a,.nav-messages-btn,.nav-btn-dashboard,.reconstruction .nav-btn-logout{position:relative;color:rgba(255,255,255,.78);text-decoration:none;font-family:'Inter',sans-serif;font-size:.95rem;font-weight:500;background:none;border:none;padding:.3rem 0;white-space:nowrap}.nav-messages-btn{display:flex;align-items:center;gap:.4rem}.nav-btn-dashboard{display:inline-flex;align-items:center;gap:8px}.avatar{border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;color:#fff;font-weight:600;user-select:none}.avatar--sm{width:28px;height:28px;font-size:.7rem}\n.current-main{padding:2rem;max-width:1200px;margin:0 auto}.dashboard-header{margin-bottom:1.75rem;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0}.dashboard-header h2{margin:0 0 .3rem;color:#1e293b;font-size:1.7rem;font-weight:700}.dashboard-header p{margin:0;color:#64748b;font-size:.95rem}.auth-tabs{display:flex;background:#f1f5f9;border-radius:10px;padding:4px;margin-bottom:1.5rem}.tab-btn{flex:1;padding:.6rem .8rem;background:transparent;color:#64748b;font-weight:600;font-size:.9rem;border-radius:8px;border:none}.tab-btn.active{background:#fff;color:#4361ee;box-shadow:0 2px 6px rgba(0,0,0,.06)}.btn-submit-offre{background:#4361ee;color:white;padding:.75rem;font-size:.95rem;font-weight:600;border-radius:8px;border:none;margin-top:.25rem}.dashboard-card{background:#fff;border-radius:12px;padding:1.6rem;border:1px solid #e2e8f0;box-shadow:0 4px 15px rgba(0,0,0,.04);margin-bottom:2.5rem}.dashboard-card h3{margin-top:0;color:#1e293b;font-size:1.2rem;margin-bottom:1.2rem;font-weight:700}.offres-recruteur-list{display:flex;flex-direction:column;gap:.9rem}.offre-recruteur-item{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:1rem;cursor:pointer}.item-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem}.item-title{margin:0;font-size:1rem;color:#1e293b;font-weight:600}.offre-entreprise{font-size:.8rem;color:#64748b;font-weight:500}.candidat-count-badge{background:#e0e7ff;color:#3730a3;padding:.2rem .6rem;border-radius:12px;font-size:.78rem;font-weight:700}.offre-meta-row{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0;align-items:center}.offre-meta-tag{font-size:.75rem;background:#f1f5f9;color:#475569;padding:.15rem .55rem;border-radius:10px;font-weight:500}.offre-meta-tag svg{width:1em;height:1em}.statut-pill{display:inline-block;padding:.25rem .75rem;border-radius:12px;font-size:.8rem;font-weight:600}.statut-acceptee{background:#dcfce7;color:#166534}.statut-refusee{background:#fee2e2;color:#991b1b}.offre-skills{display:flex;flex-wrap:wrap;gap:.4rem;margin:.8rem 0}.skill-badge{background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;padding:.25rem .65rem;border-radius:12px;font-size:.78rem;font-weight:600}.skill-required{background:#fef3c7!important;color:#92400e!important;border-color:#fde68a!important}.offre-card-actions{display:flex;gap:.5rem;margin-top:.75rem;flex-wrap:wrap}.btn-voir-candidats{background:transparent;color:#4361ee;border:none;padding:0;font-size:.85rem;font-weight:600;margin-top:.6rem;flex:1}.btn-card-edit{flex:1;padding:.45rem .75rem;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;border-radius:7px;font-size:.82rem;font-weight:600}.btn-card-delete{flex:1;padding:.45rem .75rem;background:#fef2f2;color:#dc2626;border:1px solid #fecaca;border-radius:7px;font-size:.82rem;font-weight:600}\n</style>\n<div class=\"reconstruction\" data-kid=\"1\">\n    <nav class=\"navbar\" data-kid=\"1-1\">\n        <div class=\"navbar-top\" data-kid=\"1-1-1\">\n            <a class=\"navbar-logo\" data-kid=\"1-1-1-1\">\n                <svg class=\"navbar-logo-mark\" data-kid=\"1-1-1-1-1\" fill=\"none\" height=\"26\" style=\"width:26px;height:26px;color:inherit\" viewbox=\"0 0 26 26\" width=\"26\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <circle cx=\"10\" cy=\"13\" fill=\"#F2B84B\" r=\"8\">\n                    </circle>\n                    <circle cx=\"17\" cy=\"13\" fill=\"#FFFFFF\" fill-opacity=\"0.9\" r=\"8\">\n                    </circle>\n                </svg>\n                RecrutIA\n            </a>\n        </div>\n        <div class=\"navbar-links\" data-kid=\"1-1-2\">\n            <a data-kid=\"1-1-2-1\">\n                Offres d'emploi\n            </a>\n            <div class=\"user-nav\" data-kid=\"1-1-2-2\">\n                <a class=\"nav-messages-btn\" data-kid=\"1-1-2-2-1\" data-name=\"message navigation link\">\n                    <svg data-kid=\"1-1-2-2-1-1\" fill=\"currentColor\" fill-rule=\"evenodd\" style=\"width:1.1rem;height:1.1rem;color:inherit\" viewbox=\"0 0 1024 1024\">\n                        <path d=\"M845.784 581.585a135.867 135.867 0 0 0-47.042 19.049 114.236 114.236 0 0 1-51.41 31.075c2.613-17.554 11.313-33.577 24.455-45.418a169.303 169.303 0 0 0 23.409-55.017c-.061-27.838 22.44-50.459 50.265-50.534 27.827-.076 50.45 22.423 50.539 50.26.089 27.839-22.39 50.482-50.215 50.585zM753.568 460.83a168.829 168.829 0 0 0-54.808-23.68c-27.836 0-50.402-22.575-50.402-50.423 0-27.848 22.566-50.423 50.402-50.423 27.836 0 50.402 22.575 50.402 50.423a137.497 137.497 0 0 0 18.817 47.211 114.809 114.809 0 0 1 30.764 51.656 76.08 76.08 0 0 1-45.026-24.763h-.186zm-83.033-177.713C655.34 155.789 523.548 56.026 364.09 56.026c-169.874 0-308.088 113.097-308.088 252.19 2.72 78.1 43.941 149.778 110.063 191.385a311.284 311.284 0 0 0 33.602 21.588l-13.664 54.569c4.928 2.316 9.706 4.78 14.746 6.91l68.996-34.512c10.08 2.615 20.683 4.295 31.21 6.088 6.721 1.195 13.442 2.428 20.35 3.25a354.835 354.835 0 0 0 128.805-7.396 248.885 248.885 0 0 0 10.154 55.055 425.638 425.638 0 0 1-96.175 11.242 417.983 417.983 0 0 1-86.392-9.524l-125.186 62.526a27.619 27.619 0 0 1-29.98-3.137 28.019 28.019 0 0 1-9.67-28.611l22.401-90.239C53.176 495.186 2.463 405.506 0 308.216 0 137.973 163.004 0 364.09 0c190.93 0 347.29 124.527 362.521 282.818a244.967 244.967 0 0 0-26.47-2.614c-9.893.374-19.787 1.307-29.607 2.876zM554.237 481.934c16.764-3.362 32.706-9.786 47.042-19.049a114.236 114.236 0 0 1 51.447-31.001 76.466 76.466 0 0 1-24.491 45.344c-11.014 16.807-18.929 35.483-23.409 55.054.041 27.833-22.468 50.435-50.29 50.497-27.821.062-50.43-22.44-50.514-50.273-.082-27.833 22.393-50.469 50.215-50.572m90.798 121.314c16.652 11.168 35.17 19.236 54.659 23.904 20.386 0 38.764 12.286 46.565 31.127 7.801 18.842 3.49 40.53-10.926 54.95-14.414 14.422-36.093 18.736-54.927 10.931-18.834-7.804-31.114-26.19-31.114-46.585a136.736 136.736 0 0 0-18.668-47.285 114.714 114.714 0 0 1-30.54-51.805 76 76 0 0 1 44.951 25.062z\" transform=\"translate(64 148)\">\n                        </path>\n                    </svg>\n                    <span data-kid=\"1-1-2-2-1-2\">\n                        Messages\n                    </span>\n                </a>\n                <a class=\"nav-btn-dashboard\" data-kid=\"1-1-2-2-2\" data-name=\"dashboard navigation link\">\n                    <div class=\"avatar avatar--sm\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1\" data-name=\"user initials avatar\" data-reason=\"background color computed and set by script\" id=\"recruiter-avatar\">\n                        SB\n                    </div>\n                    Mon espace\n                </a>\n                <button class=\"nav-btn-logout\" data-kid=\"1-1-2-2-3\" data-name=\"logout button\" type=\"button\">\n                    Déconnexion\n                </button>\n            </div>\n        </div>\n    </nav>\n    <main class=\"current-main\" data-kid=\"1-2\">\n        <div class=\"page-dashboard\" data-kid=\"1-2-1\">\n            <div class=\"dashboard-header\" data-kid=\"1-2-1-1\">\n                <h2 data-kid=\"1-2-1-1-1\">\n                    Tableau de bord\n                </h2>\n                <p data-kid=\"1-2-1-1-2\">\n                    Bonjour Sarah Ben Ali, voici l'état de votre activité.\n                </p>\n            </div>\n            <div class=\"auth-tabs\" data-kid=\"1-2-1-2\">\n                <button class=\"tab-btn active\" data-kid=\"1-2-1-2-1\" type=\"button\">\n                    Mes offres\n                </button>\n                <button class=\"tab-btn\" data-kid=\"1-2-1-2-2\" type=\"button\">\n                    Statistiques\n                </button>\n                <button class=\"tab-btn\" data-kid=\"1-2-1-2-3\" type=\"button\">\n                    Mon profil\n                </button>\n            </div>\n            <div data-kid=\"1-2-1-3\" style=\"margin-bottom:1.25rem\">\n                <button class=\"btn-submit-offre\" data-kid=\"1-2-1-3-1\" type=\"button\">\n                    + Publier une nouvelle offre\n                </button>\n            </div>\n            <section class=\"dashboard-card list-card\" data-kid=\"1-2-1-4\">\n                <h3 data-kid=\"1-2-1-4-1\">\n                    Mes offres d'emploi publiées (3)\n                </h3>\n                <div class=\"offres-recruteur-list\" data-dynamic=\"true\" data-kid=\"1-2-1-4-2\" data-name=\"recruiter offers list container\" data-reason=\"list of job offers injected by script\" id=\"current-recruiter-offers\">\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n<script>\n    (function(){\nconst name='Sarah Ben Ali';let hash=0;for(let i=0;i<name.length;i++)hash=name.charCodeAt(i)+((hash<<5)-hash);document.getElementById('recruiter-avatar').style.backgroundColor=['#4f46e5','#0ea5e9','#059669','#d97706','#dc2626','#7c3aed','#db2777'][Math.abs(hash)%7];\nconst timer='<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M2.336,9.685A9.934,9.934,0,0,0,13.592,21.808,9.931,9.931,0,0,0,20.708,7.23,10.046,10.046,0,0,0,12,2.072a.507.507,0,0,0-.5.5v4.2a.5.5,0,0,0,1,0v-4.2l-.5.5a8.935,8.935,0,0,1,8.433,11.892A8.938,8.938,0,0,1,6.468,19.027,9.041,9.041,0,0,1,3.3,9.951c.142-.627-.822-.9-.964-.266Z\"/><path d=\"M7.4,8.117a.5.5,0,0,1,.707-.707l4.243,4.242h0a.5.5,0,0,1-.707.707Z\"/></svg>';\nconst student='<svg viewBox=\"0 0 256 256\" fill=\"currentColor\"><path d=\"M226.53,56.41l-96-32a8,8,0,0,0-5.06,0l-96,32A8,8,0,0,0,24,64v80a8,8,0,0,0,16,0V75.1L73.59,86.29a64,64,0,0,0,20.65,88.05c-18,7.06-33.56,19.83-44.94,37.29a8,8,0,1,0,13.4,8.74C77.77,197.25,101.57,184,128,184s50.23,13.25,65.3,36.37a8,8,0,0,0,13.4-8.74c-11.38-17.46-27-30.23-44.94-37.29a64,64,0,0,0,20.65-88l44.12-14.7a8,8,0,0,0,0-15.18ZM176,120A48,48,0,1,1,89.35,91.55l36.12,12a8,8,0,0,0,5.06,0l36.12-12A47.89,47.89,0,0,1,176,120Z\"/></svg>';\nconst price='<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11 13V9c0-.55-.45-1-1-1H6V6h5V4H8.5V3h-2v1H5c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1h4v2H4v2h2.5v1h2v-1H10c.55 0 1-.45 1-1M19.59 12.52l-5.66 5.65-2.83-2.83-1.41 1.42L13.93 21 21 13.93z\"/></svg>';\nconst offers=[{title:'Développeur Full-Stack React / Node.js',count:12,exp:3,study:'Bac+5',salary:2800,type:'CDI',status:'ouverte',required:['React','Node.js','PostgreSQL'],nice:['Docker','Git']},{title:'Designer UI / UX',count:8,exp:2,study:'Bac+3',salary:2200,type:'CDI',status:'ouverte',required:['Figma','UI Design','UX Research'],nice:['Adobe Illustrator']},{title:'Data Analyst',count:6,exp:1,study:'Bac+5',salary:2000,type:'CDD',status:'fermee',required:['Python','SQL','Power BI'],nice:['Excel']}];\ndocument.getElementById('current-recruiter-offers').innerHTML=offers.map(o=>`<div class=\"offre-recruteur-item\"><div class=\"item-header\"><div><h4 class=\"item-title\">${o.title}</h4><span class=\"offre-entreprise\">NovaTech</span></div><span class=\"candidat-count-badge\">${o.count} candidatures</span></div><div class=\"offre-meta-row\"><span class=\"offre-meta-tag\">${timer}${o.exp} ans exp.</span><span class=\"offre-meta-tag\">${student} ${o.study}</span><span class=\"offre-meta-tag\">${price} ${o.salary} DT</span><span class=\"offre-meta-tag\"> Tunisie</span><span class=\"offre-meta-tag\">${o.type}</span><span class=\"statut-pill ${o.status==='ouverte'?'statut-acceptee':'statut-refusee'}\">${o.status}</span></div><div class=\"offre-skills\">${o.required.map(s=>`<span class=\"skill-badge skill-required\">${s}</span>`).join('')}${o.nice.map(s=>`<span class=\"skill-badge\">${s}</span>`).join('')}</div><div class=\"offre-card-actions\"><button type=\"button\" class=\"btn-voir-candidats\">Inspecter les candidatures</button><button type=\"button\" class=\"btn-card-edit\">Modifier</button><button type=\"button\" class=\"btn-card-delete\">Supprimer</button></div></div>`).join('');\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-10T14:32:08.588986+00:00",
