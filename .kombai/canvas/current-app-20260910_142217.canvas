    },
    "var_ca43b992b387": {
      "type": "variant",
      "label": "Current layout · Admin dashboard · Sample data",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@500;600&display=swap');\n.admin-reconstruction {font-family:'Segoe UI',system-ui,sans-serif;background:#f7f8fa;color:#2c3e50;min-height:100vh;line-height:normal;}\n.admin-reconstruction button,.admin-reconstruction input,.admin-reconstruction select {font-family:Arial,sans-serif;line-height:normal;}\n.admin-reconstruction button{cursor:pointer;}\n.navbar{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(120deg,#764090 0%,#4e2a68 100%);color:white;padding:1rem clamp(1rem,4vw,2rem);width:100%;font-family:Inter,sans-serif;border-bottom:1px solid rgba(242,184,75,.35);}\n.navbar-logo{font-family:'Space Grotesk',sans-serif;font-size:1.3rem;font-weight:700;letter-spacing:-.01em;display:flex;align-items:center;gap:.5rem;color:white;white-space:nowrap;}\n.navbar-links{display:flex;gap:clamp(.6rem,2vw,1.2rem);align-items:center;justify-content:flex-end;}\n.user-nav{display:flex;align-items:center;gap:clamp(.5rem,1.5vw,1rem);}\n.nav-item,.admin-reconstruction .nav-item{font-family:Inter,sans-serif;font-size:.95rem;font-weight:500;color:rgba(255,255,255,.78);padding:.3rem 0;background:none;border:none;display:flex;align-items:center;gap:.4rem;white-space:nowrap;}\n.admin-main{padding:2rem;max-width:1200px;margin:0 auto;}\n.dashboard-header{margin-bottom:1.75rem;padding-bottom:1.25rem;border-bottom:1px solid #e2e8f0;}\n.dashboard-header h2{margin:0 0 .3rem;color:#1e293b;font-size:1.7rem;font-weight:700;}\n.dashboard-header p{margin:0;color:#64748b;font-size:.95rem;}\n.auth-tabs{display:flex;background:#f1f5f9;border-radius:10px;padding:4px;margin-bottom:1.5rem;}\n.tab-btn{flex:1;padding:.6rem .8rem;background:transparent;color:#64748b;font-weight:600;font-size:.9rem;border-radius:8px;border:none;}\n.tab-btn.active{background:#fff;color:#4361ee;box-shadow:0 2px 6px rgba(0,0,0,.06);}\n.stats-kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;margin-bottom:1.5rem;}\n.kpi-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1.4rem 1rem;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.05);}\n.kpi-highlight{border-color:#6366f1;background:linear-gradient(135deg,#eef2ff,#f5f3ff);}\n.kpi-value{display:block;font-size:2.4rem;font-weight:800;color:#1e293b;line-height:1;margin-bottom:.9rem;}\n.kpi-highlight .kpi-value{color:#6366f1;}\n.kpi-label{font-size:.78rem;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:.04em;}\n.stats-charts-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem;margin-bottom:1.25rem;}\n.stats-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:1.4rem;box-shadow:0 2px 8px rgba(0,0,0,.05);}\n.stats-card h3{font-size:1rem;font-weight:700;margin:0 0 .3rem;color:#1e293b;}\n.btn-toggle-text{background:none;border:none;color:#4361ee;font-size:.82rem;font-weight:600;cursor:pointer;padding:0;}\n.stats-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;}\n.stats-card-header h3{margin:0;}\n.btn-submit-offre{background:#4361ee;color:white;padding:.45rem .95rem;font-size:.85rem;font-weight:600;border-radius:8px;border:none;cursor:pointer;margin-top:.25rem;}\n.admin-filters{display:flex;gap:.75rem;margin-bottom:1.25rem;flex-wrap:wrap;padding:.75rem;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0;}\n.admin-search-input{flex:1;min-width:200px;padding:.55rem .85rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.9rem;background:#fff;outline:none;}\n.admin-search-input::placeholder{color:#757575;opacity:1;}\n.admin-role-select{padding:.55rem .85rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.9rem;background:#fff;cursor:pointer;font-weight:500;appearance:auto;}\n.candidatures-table{width:100%;border-collapse:collapse;background:white;font-size:.88rem;}\n.candidatures-table th{padding:.75rem .8rem;text-align:left;border-bottom:2px solid #e2e8f0;color:#64748b;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;background:#f8fafc;}\n.candidatures-table td{padding:.75rem .8rem;text-align:left;border-bottom:1px solid #f1f5f9;vertical-align:middle;}\n.candidat-info{display:flex;flex-direction:column;}\n.candidat-nom{font-weight:600;color:#1e293b;font-size:.92rem;}\n.candidat-email{font-size:.8rem;color:#64748b;}\n.mini-skill-badge{padding:.15rem .5rem;border-radius:10px;font-size:.72rem;font-weight:600;}\n.statut-pill{display:inline-block;padding:.25rem .75rem;border-radius:12px;font-size:.8rem;font-weight:600;}\n.statut-acceptee{background:#dcfce7;color:#166534;}\n.statut-refusee{background:#fee2e2;color:#991b1b;}\n.action-buttons-group{display:flex;gap:.4rem;}\n.btn-action{padding:.35rem .65rem;font-size:.78rem;font-weight:600;border-radius:6px;border:none;cursor:pointer;}\n.btn-reject{background:#ef4444;color:white;}.btn-accept{background:#10b981;color:white;}\n.chart-legend{display:flex;justify-content:center;gap:10px;height:36px;align-items:flex-start;font-size:16px;}\n.chart-legend span{display:flex;align-items:center;gap:4px;}.legend-swatch{width:14px;height:10px;display:inline-block;}\n.chart-fallback > span:nth-of-type(1){left:70px!important;top:138px!important;}\n.chart-fallback > span:nth-of-type(2){left:48px!important;top:23px!important;right:auto!important;}\n.chart-fallback > span:nth-of-type(3){left:135px!important;top:45px!important;right:auto!important;bottom:auto!important;}\n</style>\n<div class=\"admin-reconstruction\" data-kid=\"1\">\n    <nav class=\"navbar\" data-kid=\"1-1\">\n        <div class=\"navbar-logo\" data-kid=\"1-1-1\">\n            <svg data-kid=\"1-1-1-1\" data-name=\"RecrutIA logo icon\" fill=\"none\" height=\"26\" style=\"color:white;width:26px;height:26px\" viewbox=\"0 0 26 26\" width=\"26\" xmlns=\"http://www.w3.org/2000/svg\">\n                <circle cx=\"10\" cy=\"13\" fill=\"#F2B84B\" r=\"8\">\n                </circle>\n                <circle cx=\"17\" cy=\"13\" fill=\"#FFFFFF\" fill-opacity=\"0.9\" r=\"8\">\n                </circle>\n            </svg>\n            RecrutIA\n        </div>\n        <div class=\"navbar-links\" data-kid=\"1-1-2\">\n            <span class=\"nav-item\" data-kid=\"1-1-2-1\" data-name=\"navigation link for job offers\">\n                Offres d'emploi\n            </span>\n            <div class=\"user-nav\" data-kid=\"1-1-2-2\">\n                <span class=\"nav-item\" data-kid=\"1-1-2-2-1\" data-name=\"messages navigation link\">\n                    <svg data-kid=\"1-1-2-2-1-1\" fill=\"currentColor\" fill-rule=\"evenodd\" style=\"width:17.6px;height:17.6px;color:rgba(255,255,255,.78)\" viewbox=\"0 0 1024 1024\">\n                        <path d=\"M845.784 581.585a135.867 135.867 0 0 0-47.042 19.049 114.236 114.236 0 0 1-51.41 31.075c2.613-17.554 11.313-33.577 24.455-45.418a169.303 169.303 0 0 0 23.409-55.017c-.061-27.838 22.44-50.459 50.265-50.534 27.827-.076 50.45 22.423 50.539 50.26.089 27.839-22.39 50.482-50.215 50.585zM753.568 460.83a168.829 168.829 0 0 0-54.808-23.68c-27.836 0-50.402-22.575-50.402-50.423 0-27.848 22.566-50.423 50.402-50.423 27.836 0 50.402 22.575 50.402 50.423a137.497 137.497 0 0 0 18.817 47.211 114.809 114.809 0 0 1 30.764 51.656 76.08 76.08 0 0 1-45.026-24.763h-.186zm-83.033-177.713C655.34 155.789 523.548 56.026 364.09 56.026c-169.874 0-308.088 113.097-308.088 252.19 2.72 78.1 43.941 149.778 110.063 191.385a311.284 311.284 0 0 0 33.602 21.588l-13.664 54.569c4.928 2.316 9.706 4.78 14.746 6.91l68.996-34.512c10.08 2.615 20.683 4.295 31.21 6.088 6.721 1.195 13.442 2.428 20.35 3.25a354.835 354.835 0 0 0 128.805-7.396 248.885 248.885 0 0 0 10.154 55.055 425.638 425.638 0 0 1-96.175 11.242 417.983 417.983 0 0 1-86.392-9.524l-125.186 62.526a27.619 27.619 0 0 1-29.98-3.137 28.019 28.019 0 0 1-9.67-28.611l22.401-90.239C53.176 495.186 2.463 405.506 0 308.216 0 137.973 163.004 0 364.